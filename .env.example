# Set to 1 only when intentionally running tests that place live orders or move funds.
RUN_LIVE_TRADING_TESTS=
# Requires RUN_LIVE_TRADING_TESTS=1 too; permits tests that seek a real fill.
RUN_LIVE_FILL_TESTS=

BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_SUB_MEMBER_ID=
BYBIT_DEPOSIT_ACCOUNT_TYPE=FUND

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_API_SECRET=

KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

MEXC_API_KEY=
MEXC_API_SECRET=

BINGX_API_KEY=
BINGX_API_SECRET=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Use the master account address here, not the API wallet address.
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# Lighter clients select their network explicitly. Both credential groups may
# be configured and used concurrently; there is no LIGHTER_NETWORK selector.
LIGHTER_MAINNET_ACCOUNT_INDEX=
LIGHTER_MAINNET_API_KEY_INDEX=
LIGHTER_MAINNET_API_PRIVATE_KEY=

# Robinhood Lighter is an independent signing chain and account namespace.
LIGHTER_ROBINHOOD_ACCOUNT_INDEX=
LIGHTER_ROBINHOOD_API_KEY_INDEX=
LIGHTER_ROBINHOOD_API_PRIVATE_KEY=

BACKPACK_API_KEY=
BACKPACK_API_SECRET=

ASTER_USER_ADDRESS=
ASTER_SIGNER_ADDRESS=
ASTER_PRIVATE_KEY=

EXTENDED_API_KEY=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_VAULT_NUMBER=
EXTENDED_CLIENT_ID=

# Optional Arcus Perps credentials; leave blank until the account has access.
# API key is the Ed25519 public key; signing key is its 32-byte private seed.
# Select mainnet or testnet in the client; these values are one credential set.
ARCUS_API_KEY=
ARCUS_API_SIGNING_KEY=
ARCUS_ADDRESS=

# Ondo currently supports perpetual futures only; spot is not available.
# Dashboard "Public Key" (ondoKeyId_...) maps to API_KEY_ID.
# Dashboard "Private Key" (ondoApiSecret_...) maps to API_SECRET.
ONDO_API_KEY_ID=
ONDO_API_SECRET=
