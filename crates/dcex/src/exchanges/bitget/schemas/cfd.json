  {
    "name": "cfd_account_transfer",
    "method": "POST",
    "path": "/api/v3/cfd/account/transfer",
    "public": false,
    "confirm": false,
    "scoped": false,
    "fields": [
      {
        "wire": "coin",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Coin to transfer",
          "examples": [
            "USDT"
          ]
        },
        "location": "body"
      },
      {
        "wire": "amount",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Amount to transfer",
          "examples": [
            "100"
          ]
        },
        "location": "body"
      },
      {
        "wire": "accountType",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Account type<br/>`funding`: Spot/Funding account<br/>`uta`: Unified Trading Account",
          "examples": [
            "uta"
          ]
        },
        "location": "body"
      },
      {
        "wire": "direction",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Transfer direction<br/>`in`: Deposit into the CFD account<br/>`out`: Withdraw from the CFD account",
          "examples": [
            "in"
          ]
        },
        "location": "body"
      }
    ],
    "source": "https://www.bitget.com/docs/catalog/cfd-account/cfd-account#cfd-transfer",
    "summary": "Transfer",
    "input_schema": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "format": "decimal",
          "x-positive": true
        }
      }
    }
  },
