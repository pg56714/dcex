  {
    "name": "cfd_trade_place_order",
    "method": "POST",
    "path": "/api/v3/cfd/trade/place-order",
    "public": false,
    "confirm": false,
    "scoped": false,
    "fields": [
      {
        "wire": "symbol",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Trading pair name",
          "examples": [
            "XAUUSD"
          ]
        },
        "location": "body"
      },
      {
        "wire": "orderType",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Order type<br/>`limit`: Limit order<br/>`market`: Market order",
          "examples": [
            "market"
          ]
        },
        "location": "body"
      },
      {
        "wire": "side",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Trade side<br/>`buy`: Buy<br/>`sell`: Sell",
          "examples": [
            "buy"
          ]
        },
        "location": "body"
      },
      {
        "wire": "price",
        "required": false,
        "schema": {
          "type": "string",
          "description": "Order price<br/>Required when `orderType=limit`<br/>The price must be an integer multiple of the trading pair's precision"
        },
        "location": "body"
      },
      {
        "wire": "qty",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Order quantity",
          "examples": [
            "1"
          ]
        },
        "location": "body"
      },
      {
        "wire": "takeProfit",
        "required": false,
        "schema": {
          "type": "string",
          "description": "Take-profit price<br/>The price must be an integer multiple of the trading pair's precision"
        },
        "location": "body"
      },
      {
        "wire": "stopLoss",
        "required": false,
        "schema": {
          "type": "string",
          "description": "Stop-loss price<br/>The price must be an integer multiple of the trading pair's precision"
        },
        "location": "body"
      }
    ],
    "source": "https://www.bitget.com/docs/catalog/cfd-trade/cfd-trade#place-cfd-order",
    "summary": "Place CFD Order",
    "input_schema": {
      "type": "object",
      "properties": {
        "price": {
          "type": "string",
          "format": "decimal"
        },
        "qty": {
          "type": "string",
          "format": "decimal"
        },
        "stopLoss": {
          "type": "string",
          "format": "decimal"
        },
        "stop_loss": {
          "type": "string",
          "format": "decimal"
        },
