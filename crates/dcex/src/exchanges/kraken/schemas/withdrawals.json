                                          "enum": [
                                            "currency",
                                            "tokenized_asset"
                                          ]
                                        },
                                        "name": {
                                          "type": "string",
                                          "minLength": 1,
                                          "maxLength": 16
                                        }
                                      },
                                      "required": [
                                        "class",
                                        "name"
                                      ]
                                    },
                                    "amount": {
                                      "type": "string",
                                      "pattern": "^[+-]?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))$"
                                    }
                                  },
                                  "required": [
                                    "asset",
                                    "amount"
                                  ]
