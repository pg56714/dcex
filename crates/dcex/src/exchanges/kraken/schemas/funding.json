[
  {
    "name": "calculate_funding_fees",
    "method": "GET",
    "path": "/funding/v1/fees/{method_id}",
    "auth": "header",
    "fields": [
      {
        "name": "method_id",
        "location": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-?(?:[0-9a-fA-F]{4}-?){3}[0-9a-fA-F]{12}$"
        }
      },
      {
        "name": "amount",
        "location": "query",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[+-]?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))$"
        }
      },
      {
        "name": "fee_included",
        "location": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "withdrawal_fee_token",
        "location": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      {
        "name": "rebase_multiplier",
        "location": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "rebased",
            "base"
          ]
        }
      },
      {
        "name": "account_id",
        "location": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "otp",
        "location": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    ],
    "official_source": "https://docs.kraken.com/api-reference/funding-beta/calculate-funding-fees",
    "input_schema": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "format": "decimal"
        },
        "withdrawal_fee_token": {
          "type": "string",
          "description": "calculate_funding_fees/withdrawal_fee_token: selects currency identifiers or funding source categories for this operation."
        }
      }
    }
  },
