  {
    "method": "POST",
    "path": "/v5/rwa/stocks/order",
    "title": "Place Stock Order",
    "official_source": "https://bybit-exchange.github.io/docs/v5/stocks/place-order",
    "name": "place_stock_order",
    "public": false,
    "fields": [
      {
        "name": "symbol",
        "python_name": "symbol",
        "type": "string",
        "required": true,
        "description": "Stock symbol, e.g. `TSLA-US`, `AAPL-US"
      },
      {
        "name": "quoteToken",
        "python_name": "quote_token",
        "type": "string",
        "required": true,
        "description": "Quote asset. Currently only `USDC` is supported"
      },
      {
        "name": "side",
        "python_name": "side",
        "type": "string",
        "required": true,
        "description": "BUY`, `SELL"
      },
      {
        "name": "type",
        "python_name": "order_type",
        "type": "string",
        "required": true,
        "description": "Order type. `MARKET`, `LIMIT`, `STOP`, `STOP_LIMIT"
      },
      {
        "name": "qty",
        "python_name": "qty",
        "type": "string",
        "required": false,
        "description": "Order quantity. **Required** for `SELL`; **required** for `BUY` with `type=LIMIT`/`STOP`/`STOP_LIMIT`. Mutually exclusive with `notional"
      },
      {
        "name": "notional",
        "python_name": "notional",
        "type": "string",
        "required": false,
        "description": "Notional amount (USDC). Only valid when `side=BUY` and `type=MARKET`. Mutually exclusive with `qty"
      },
      {
        "name": "limitPrice",
        "python_name": "limit_price",
        "type": "string",
        "required": false,
        "description": "Limit price. **Required** when `type=LIMIT` or `STOP_LIMIT"
      },
      {
        "name": "stopPrice",
        "python_name": "stop_price",
        "type": "string",
        "required": false,
        "description": "Trigger price. **Required** when `type=STOP` or `STOP_LIMIT"
      },
      {
        "name": "timeInForce",
        "python_name": "time_in_force",
        "type": "string",
        "required": true,
        "description": "Time in force: `DAY` / `GTC` / `IOC`. `SELL` only supports `DAY` / `GTC`; `IOC` requires `type=LIMIT` + whole-share `qty` + `tradingSession=RTH"
      },
      {
        "name": "tradingSession",
        "python_name": "trading_session",
        "type": "string",
        "required": false,
        "description": "Trading session. `RTH` (default), `24H`. Non-`RTH` sessions accept `LIMIT` orders only"
      },
      {
        "name": "tokenize",
        "python_name": "tokenize",
        "type": "boolean",
        "required": false,
        "description": "Whether to auto tokenize after the order is filled. Default: `false`. Only valid for `BUY"
      },
      {
        "name": "orderTime",
        "python_name": "order_time",
        "type": "integer",
        "required": true,
        "description": "Client order timestamp in milliseconds"
      },
      {
        "name": "requestId",
        "python_name": "request_id",
        "type": "string",
        "required": true,
        "description": "Idempotency key. Length ≤ 36. Alphanumeric plus `-` `_`. Must be unique within 24 hours for the same MM account"
      }
    ],
