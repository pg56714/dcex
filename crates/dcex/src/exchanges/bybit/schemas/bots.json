  {
    "method": "POST",
    "path": "/v5/fcombobot/create",
    "title": "Create Bot",
    "official_source": "https://bybit-exchange.github.io/docs/v5/bot/futures-combo/create",
    "name": "create_fcombobot",
    "public": false,
    "fields": [
      {
        "name": "leverage",
        "python_name": "leverage",
        "type": "string",
        "required": true,
        "description": "Position leverage multiplier (e.g. `\"5\"` means 5x). Must be >= 1"
      },
      {
        "name": "init_margin",
        "python_name": "init_margin",
        "type": "string",
        "required": true,
        "description": "Initial investment in quote currency (decimal string, e.g. `\"1000\"` for 1000 USDT)"
      },
      {
        "name": "adjust_position_mode",
        "python_name": "adjust_position_mode",
        "type": "integer",
        "required": true,
        "description": "Rebalancing trigger mode: `1` Time, `2` Percentage, `3` Time or Percentage, `4` Manual, `5` On settings change, `6` On transfer"
      },
      {
        "name": "symbol_settings",
        "python_name": "symbol_settings",
        "type": "array<object>",
        "required": true,
        "description": "Per-symbol portfolio configuration. At least one entry required. All `target_position_percent` must sum to 1"
      },
      {
        "name": "adjust_position_percent",
        "python_name": "adjust_position_percent",
        "type": "string",
        "required": false,
        "description": "Rebalancing drift threshold as percentage, range: [0.01, 0.5] (e.g. `\"0.05\"` means rebalance when allocation drifts 5%). **Required** when mode includes percentage"
      },
      {
        "name": "adjust_position_time_interval",
        "python_name": "adjust_position_time_interval",
        "type": "integer",
        "required": false,
        "description": "Rebalancing time interval **in seconds**. **Required** when mode includes time. `30M`, `1H`, `4H`, `8H`, `12H`, `1D`, `3D`, `7D`, `14D`, `28D` convert to seconds"
      },
      {
        "name": "sl_percent",
        "python_name": "sl_percent",
        "type": "string",
        "required": false,
        "description": "Stop-loss as percentage of total margin (e.g. `\"0.2\"` means close when loss reaches 20%)"
      },
      {
        "name": "tp_percent",
        "python_name": "tp_percent",
        "type": "string",
        "required": false,
        "description": "Take-profit as percentage of total margin (e.g. `\"0.5\"` means close when profit reaches 50%)"
      },
      {
        "name": "trailing_stop_percent",
        "python_name": "trailing_stop_percent",
        "type": "string",
        "required": false,
        "description": "Trailing stop callback as percentage (e.g. `\"0.05\"` means 5%)"
      }
    ],
    "example": {
      "leverage": "5",
      "init_margin": "500",
      "adjust_position_mode": 3,
      "adjust_position_percent": "0.05",
      "adjust_position_time_interval": 3600,
      "symbol_settings": [
        {
          "symbol": "BTCUSDT",
          "target_position_percent": "0.5",
          "side": 1
        },
        {
          "symbol": "ETHUSDT",
          "target_position_percent": "0.5",
          "side": 2
        }
      ],
      "sl_percent": "0.2",
      "tp_percent": "0.5"
    },
    "has_example": true,
    "source_file": "v5/bot/futures-combo/create.mdx",
    "spec_commit": "d193e92e52bc48a60512ca95a79ab79f4bb16f75",
